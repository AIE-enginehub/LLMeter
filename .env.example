DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/gongs_credit"
AUTH_SECRET="your-jwt-secret-change-in-production"
ADMIN_INITIAL_PASSWORD="admin123"

# ========================================
# 模型路由配置
# 格式：
#   ROUTE_{NAME}_MODELS="模型匹配模式"  — 逗号分隔，支持 * 通配符
#   ROUTE_{NAME}_BASE_URL="转发目标"    — 厂商 API 根地址（不带路径前缀）
#
# 调用方式和原始 API 完全一致，只需替换域名：
#   原来：https://api.openai.com/v1/chat/completions
#   现在：http://localhost:3000/v1/chat/completions
# ========================================

# OpenAI
ROUTE_OPENAI_MODELS="gpt-*,o1-*,o3-*,o4-*,text-embedding-*,dall-e-*,tts-*,whisper-*,chatgpt-*"
ROUTE_OPENAI_BASE_URL="https://api.openai.com"

# Gemini
ROUTE_GEMINI_MODELS="gemini-*"
ROUTE_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# Anthropic Claude (示例)
# ROUTE_CLAUDE_MODELS="claude-*"
# ROUTE_CLAUDE_BASE_URL="https://api.anthropic.com"

# 无模型请求的默认转发地址（如 GET /v1/models）
# DEFAULT_V1_BASE_URL="https://api.openai.com"
# DEFAULT_V1BETA_BASE_URL="https://generativelanguage.googleapis.com"
